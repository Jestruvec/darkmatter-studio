---
import Analytics from '@/components/Analytics.astro';
import '../styles/global.css';
import { PageFooter, PageHeader } from '@/components';

type LayoutProps = {
  title?: string;
  description?: string;
  canonical?: string; // URL absoluta
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string; // URL absoluta
};

const {
  title = "DarkMatter Studio",
  description = "Desarrollamos sitios web modernos, rápidos y personalizados para tu negocio.",
  canonical = "https://darkmatter-studio.com/",
  ogTitle = title,
  ogDescription = "Impulsa tu presencia digital con sitios web modernos, rápidos y adaptados a tu negocio.",
  ogUrl = "https://darkmatter-studio.com/",
} = Astro.props as LayoutProps;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content="/og-image.png" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content="/og-image.png" />

    <link rel="manifest" href="/site.webmanifest" />
    <Analytics />
  </head>
  <body>
    <div class="grid grid-rows-[auto_1fr_auto] min-h-screen">
      <PageHeader />
      <main>
        <slot />
      </main>
      <PageFooter />
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
